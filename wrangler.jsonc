{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pnk",
  "account_id": "d6ed180b8d67545b48d97cf7f344a9d1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "MASTER_ADMIN_ID": "bosmile",
    "TELEGRAM_BOT_TOKEN": "9070832704:AAG4_wVrNaKj87Z8iaM3kYg-Cnp_ClbPH50"
  },
  "triggers": {
    "crons": ["30 1 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mua-hang-db",
      "database_id": "b9758dfb-ea50-4534-8372-7798ec7fb9e6",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "mua-hang-files"
    },
    {
      "binding": "R2_BUCKET",
      "bucket_name": "mua-hang-files"
    }
  ]
}
